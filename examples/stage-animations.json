{
  "name": "Breathing Silhouettes",
  "animations": [
    {
      "selector": ".actor-silhouette",
      "keyframes": [
        { "transform": "translateY(0px) scale(1)" },
        { "transform": "translateY(-3px) scale(1.015)" },
        { "transform": "translateY(0px) scale(1)" }
      ],
      "options": { "duration": 2600, "iterations": "Infinity", "easing": "ease-in-out" }
    }
  ]
}
